		</dependency>
		<!-- Boot web + Jackson 2 (not starter-jackson / Jackson 3). Layout ZIP for loader.path. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
