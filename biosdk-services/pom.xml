		<dependencies>
			<dependency>
				<groupId>io.mosip.kernel</groupId>
				<artifactId>kernel-core</artifactId>
				<version>${kernel.core.version}</version>
			</dependency>
			<dependency>
				<groupId>io.mosip.kernel</groupId>
