<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath />
	</parent>

	<groupId>io.mosip.biosdk</groupId>
	<artifactId>biosdk-services</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>biosdk-services</name>
	<description>MOSIP REST wrapper for IBioApiV2. Loads a vendor or mock SDK from -Dloader.path (biosdk_bioapi_impl) and exposes init, match, check-quality, extract-template, segment, and convert-format (convertFormatV2) under /biosdk-service/. JSON envelope is a Base64 request with top-level errors. Spring Boot ZIP layout (PropertiesLauncher). JDK 21, Boot 4.1.1, Jackson 2 via spring-boot-jackson2. kernel-core and kernel-biometrics-api; no kernel-bom.</description>
	<url>https://github.com/mosip/biosdk-services</url>

	<!--
		Boot process (ZIP layout + loader.path for vendor/mock IBioApiV2).
		Listen :9099 /biosdk-service/. Health GET /. Swagger /swagger-ui.html.
		Spec version "1.0" (BioSdkServiceProviderImpl_V_1_0). Factory selects by RequestDto.version.
		Build: mvn clean install -Dgpg.skip=true  (PowerShell: quote "-D...")
		Local: run-local.bat|sh init|test|run|all. -Dspring.cloud.config.enabled=false -Dspring.profiles.active=local.
		Fat mock-sdk shades Boot 3; run-local rebuilds .local/mock-sdk-loader.jar without Spring/Tomcat/Logback.
		No kernel-bom. kernel-core = kernel + commons (logger). kernel-biometrics-api = IBioApiV2 SPI.
		Do not add mosip.kernel.version / mosip.commons.version. Do not jump to Jackson 3, JAXB 4, logstash 9.
		Exclusions on kernel-core drop unused transitives (JPA/PDF/JUnit) for size and MPL-compatible licenses.
		git-commit-id-plugin writes target/classes/service-git.properties (not git.properties).
		dotGitDirectory is ${project.basedir}/../.git because this POM is a subdirectory of the repo.
	-->
	<!-- Standalone module: versions live here. Do not reintroduce kernel-bom. -->
	<properties>
		<!-- ── Java ─────────────────────────────────────────────────────────── -->
		<java.version>21</java.version>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- ── Maven plugins & build tooling (Maven 3.9 + JDK 21; not 4.x plugin betas) ─ -->
		<maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
		<maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
		<maven.jacoco.version>0.8.15</maven.jacoco.version>
		<maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
		<maven.sonar.plugin.version>5.8.0.7211</maven.sonar.plugin.version>
		<maven.javadoc.version>3.12.0</maven.javadoc.version>
		<maven.deploy.plugin.version>3.2.0</maven.deploy.plugin.version>
		<maven.install.plugin.version>3.2.0</maven.install.plugin.version>
		<maven.dependency.plugin.version>3.11.0</maven.dependency.plugin.version>
		<maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
		<maven.clean.plugin.version>3.5.0</maven.clean.plugin.version>
		<nexus.staging.maven.plugin.version>1.7.0</nexus.staging.maven.plugin.version>
		<maven.source.plugin.version>3.4.0</maven.source.plugin.version>
		<maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
		<!-- kattu maven-build greps pl.project13.maven:git-commit-id-plugin; do not rename. -->
		<git.commit.id.plugin.version>4.9.10</git.commit.id.plugin.version>
		<central.publishing.maven.plugin.version>0.11.0</central.publishing.maven.plugin.version>
		<sonar.coverage.exclusions>**/constants/**,**/dto/**,**/config/**,**/Status/**</sonar.coverage.exclusions>
		<sonar.cpd.exclusions>**/dto/**,**/config/**</sonar.cpd.exclusions>
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

		<!-- JAXB 2.3.x (JDK 21 has none). Encoder 8.x (9.x needs Jackson 3). springdoc 3.x = Boot 4. -->
		<lombok.version>1.18.48</lombok.version>
		<json.simple.version>1.1.1</json.simple.version>
		<jaxb.runtime.version>2.3.9</jaxb.runtime.version>
		<logstash.logback.encoder.version>8.1</logstash.logback.encoder.version>
		<springdoc.openapi.starter.webmvc.ui.version>3.1.1</springdoc.openapi.starter.webmvc.ui.version>
		<swagger.annotations.version>1.6.14</swagger.annotations.version>

		<!-- ── MOSIP (kernel + commons folded into kernel-core; no kernel-bom) ─ -->
		<kernel.core.version>1.4.1-SNAPSHOT</kernel.core.version>
		<mosip.biometrics.util.version>1.4.0-SNAPSHOT</mosip.biometrics.util.version>
	</properties>

